{
  "name": "playwright-affected",
  "version": "0.1.0",
  "description": "Change-based Playwright test selection: map a git diff to tags and test paths, fail open to the full suite.",
  "type": "module",
  "bin": {
    "playwright-affected": "./dist/cli.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "playwright",
    "test-selection",
    "test-impact-analysis",
    "ci"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
